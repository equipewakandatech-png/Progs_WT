import cv2
import numpy as np
import time
import serial
import threading
import subprocess
import os
import sys
from picamera2 import Picamera2  # Usando PiCamera no percurso

# >>> 1. CONSTANTES E CONFIGURAÇÕES
LARGURA = 640
ALTURA = 480
VEL_BASE = 0.4
MARGEM_TOLERANCIA = 5
KP_BASE = 0.001
K_AGRESSIVO = 0.00002
FRAMES_NECESSARIOS = 3
AREA_MINIMA_VERDE = 600
PIXELS_MINIMOS_VERMELHO = 1000  
AREA_MINIMA_CINZA = 800  
FONTE = cv2.FONT_HERSHEY_PLAIN

# Paleta de Cores BGR
BRANCO = (255, 255, 255)
PRETO = (0, 0, 0)
VERDE = (0, 255, 0)
VERMELHO = (0, 0, 255)
AMARELO = (0, 255, 255)
LARANJA = (0, 165, 255)
CIANO = (255, 255, 0)
ROSA = (180, 105, 255)
CINZA_DEBUG = (128, 128, 128)

# Limites HSV
LOWER_GREEN = np.array([35, 50, 50])
UPPER_GREEN = np.array([85, 255, 255])
LOWER_RED1 = np.array([0, 70, 50])
UPPER_RED1 = np.array([10, 255, 255])
LOWER_RED2 = np.array([170, 70, 50])
UPPER_RED2 = np.array([180, 255, 255])

# HSV do Cinza
LOWER_GREY = np.array([0, 0, 80])     
UPPER_GREY = np.array([180, 35, 255]) 

# Variáveis de Estado
memoria_centro_cx = []
prev_time = 0
fps = 0
frames_confirmacao_falsa = 0
frames_verde_esq = 0
frames_verde_dir = 0
frames_beco = 0
frames_vermelho = 0
frames_cinza = 0
distancia_obstaculo = 999  

# >>> 2. CONEXÃO SERIAL GLOBAL E THREAD DE LEITURA
ser_global = None
rodando_serial = True  

def thread_ler_serial():
    global distancia_obstaculo, ser_global, rodando_serial
    porta_serial = '/dev/ttyACM0'
    baud_rate = 115200

    print(f"-> Tentando conectar na porta Serial {porta_serial}...")
    while rodando_serial:
        try:
            ser_global = serial.Serial(porta_serial, baud_rate, timeout=1)
            ser_global.flush()
            print(f"-> [OK] Conectado ao Arduino na porta {porta_serial}!")
            while rodando_serial and ser_global and ser_global.is_open:
                if ser_global.in_waiting > 0:
                    linha = ser_global.readline().decode('utf-8', errors='ignore').strip()
                    if linha.isdigit():
                        distancia_obstaculo = int(linha)
        except (serial.SerialException, OSError) as e:
            if rodando_serial:
                print(f"-> [ERRO SERIAL] Desconectado ou indisponível. Tentando reconectar...")
                ser_global = None
                time.sleep(2)

serial_worker = threading.Thread(target=thread_ler_serial, daemon=True)
serial_worker.start()

# >>> 3. CONTROLE DE VÍDEO (PICAMERA2) E ARDUINO
camera = Picamera2()
configuracao = camera.create_preview_configuration(
    main={"size": (LARGURA, ALTURA), "format": "BGR888"}
)
camera.configure(configuracao)
camera.start()

def enviar_comando(vel_esq, vel_dir):
    global ser_global
    vel_esq = max(-1.0, min(1.0, vel_esq))
    vel_dir = max(-1.0, min(1.0, vel_dir))
    
    if ser_global and ser_global.is_open:
        try:
            comando = f"{vel_esq:.2f},{vel_dir:.2f}\n"
            ser_global.write(comando.encode('utf-8'))
        except Exception as e:
            print(f"-> [ERRO AO ENVIAR SERIAL]: {e}")
            
    return vel_esq, vel_dir

def chamar_resgatezits():
    global ser_global, rodando_serial
    print("-> Parando motores e liberando periféricos para o resgate...")
    enviar_comando(0.0, 0.0)
    
    rodando_serial = False
    time.sleep(0.3)
    
    if ser_global and ser_global.is_open:
        ser_global.close()
        ser_global = None

    # Parando a Picamera2
    camera.stop()
    time.sleep(1.0)
    
    print("-> Invocando resgatezits.py e encerrando raspzits.py...")
    python_bin = sys.executable
    os.execv(python_bin, [python_bin, "resgatezits.py"])

def executar_desvio_obstaculo():
    global distancia_obstaculo
    enviar_comando(0.0, 0.0)
    time.sleep(0.8)

    enviar_comando(-0.5, 0.5) 
    time.sleep(0.6)
    enviar_comando(0.4, 0.4)  
    time.sleep(1.0)
    enviar_comando(0.5, -0.5) 
    time.sleep(0.6)
    enviar_comando(0.0, 0.0)
    
    distancia_obstaculo = 999

def manobra_beco():
    enviar_comando(-0.5, 0.5)
    time.sleep(1.2)
    enviar_comando(0.0, 0.0)

def manobra_90(direcao):
    if direcao == "ESQUERDA":
        enviar_comando(-0.5, 0.5)
    else:
        enviar_comando(0.5, -0.5)
    time.sleep(0.6)
    enviar_comando(0.0, 0.0)

def executar_entrada_resgate():
    print("-> Entrada da sala de resgate detectada! Avançando 30cm...")
    enviar_comando(0.0, 0.0)
    time.sleep(0.2)

    enviar_comando(0.4, 0.4)
    time.sleep(1.2) 

    enviar_comando(0.0, 0.0)
    time.sleep(0.3)

    chamar_resgatezits()

# >>> 4. PROCESSAR_FRAME
def processar_frame(frame):
    global prev_time, fps
    global frames_confirmacao_falsa, frames_verde_esq, frames_verde_dir, frames_beco
    global frames_vermelho, frames_cinza, distancia_obstaculo
    global memoria_centro_cx

    frame = frame.copy()
    h, w, _ = frame.shape
    status = "SIGA"
    acao_imediata = False
    vel_esq_final = VEL_BASE
    vel_dir_final = VEL_BASE
    executar_manobra_90 = False
    executar_retorno_beco = False
    executar_resgate = False
    direcao_manobra = ""

    current_time = time.time()
    if current_time - prev_time > 0:
        fps = int(1 / (current_time - prev_time))
    prev_time = current_time

    x_inicio_guia = (w // 2) - int((w * 0.20) / 2)
    x_fim_guia = (w // 2) + int((w * 0.20) / 2)
    altura_linha_guia = int(h * 0.20)
    roi_verde_y1, roi_verde_y2 = int(h * 0.40), int(h * 0.65)
    
    roi_cinza_y1 = int(h * 0.60)
    roi_cinza_y2 = int(h * 0.70)
    
    roi_linha_y1, roi_linha_y2 = int(h * 0.65), int(h * 0.90)
    roi_vermelho_y1 = int(h * 0.85)
    posicao_linha_amarela = int(h * 0.66)
    cx_suave = w // 2

    if distancia_obstaculo < 30: 
        status = f"OBSTACULO: {distancia_obstaculo}cm - PARADO"
        executar_desvio_obstaculo()
        distancia_obstaculo = 999 
        memoria_centro_cx.clear()
        return

    zona_cinza = frame[roi_cinza_y1:roi_cinza_y2, :]
    hsv_cinza = cv2.cvtColor(zona_cinza, cv2.COLOR_BGR2HSV)
    mask_cinza = cv2.inRange(hsv_cinza, LOWER_GREY, UPPER_GREY)
    
    kernel_cinza = np.ones((5, 5), np.uint8)
    mask_cinza = cv2.morphologyEx(mask_cinza, cv2.MORPH_CLOSE, kernel_cinza)
    mask_cinza = cv2.morphologyEx(mask_cinza, cv2.MORPH_OPEN, kernel_cinza)
    
    pixels_cinza = cv2.countNonZero(mask_cinza)

    if pixels_cinza > AREA_MINIMA_CINZA:
        frames_cinza += 1
    else:
        frames_cinza = max(0, frames_cinza - 1)

    roi_vermelho_y2 = h
    zona_vermelho = frame[roi_vermelho_y1:roi_vermelho_y2, :]
    hsv_vermelho = cv2.cvtColor(zona_vermelho, cv2.COLOR_BGR2HSV)
    mask_red1 = cv2.inRange(hsv_vermelho, LOWER_RED1, UPPER_RED1)
    mask_red2 = cv2.inRange(hsv_vermelho, LOWER_RED2, UPPER_RED2)
    mask_vermelho_total = cv2.add(mask_red1, mask_red2)
    pixels_vermelho = cv2.countNonZero(mask_vermelho_total)

    if not acao_imediata:
        if pixels_vermelho > PIXELS_MINIMOS_VERMELHO:
            frames_vermelho += 1
        else:
            frames_vermelho = max(0, frames_vermelho - 1)

        if frames_vermelho >= FRAMES_NECESSARIOS:
            status = "LINHA VERMELHA - PARE"
            acao_imediata = True
            vel_esq_final = 0
            vel_dir_final = 0
            frames_vermelho = FRAMES_NECESSARIOS

    zona_linha = frame[roi_linha_y1:roi_linha_y2, :]
    gray = cv2.cvtColor(zona_linha, cv2.COLOR_BGR2GRAY)
    blur = cv2.GaussianBlur(gray, (5, 5), 0)
    _, mask_preta = cv2.threshold(blur, 0, 255, cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU)
    linha_detectada = False

    if not acao_imediata:
        contornos_linha, _ = cv2.findContours(mask_preta, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        if contornos_linha:
            c = max(contornos_linha, key=cv2.contourArea)
            if cv2.contourArea(c) > 600:
                M = cv2.moments(c)
                if M["m00"] != 0:
                    cx_atual = int(M["m10"] / M["m00"])
                    memoria_centro_cx.append(cx_atual)
                    if len(memoria_centro_cx) > 3:
                        memoria_centro_cx.pop(0)
                    cx_suave = sum(memoria_centro_cx) // len(memoria_centro_cx)
                    linha_detectada = True
        else:
            memoria_centro_cx.clear()

    roi_horizontal_y1 = posicao_linha_amarela
    roi_horizontal_y2 = posicao_linha_amarela + 2
    zona_horizontal = frame[roi_horizontal_y1:roi_horizontal_y2, :]
    hsv_hz = cv2.cvtColor(zona_horizontal, cv2.COLOR_BGR2HSV)
    mask_verde_na_linha = cv2.inRange(hsv_hz, LOWER_GREEN, UPPER_GREEN)
    gray_horizontal = cv2.cvtColor(zona_horizontal, cv2.COLOR_BGR2GRAY)
    gray_horizontal[mask_verde_na_linha > 0] = 255
    blur_hz = cv2.GaussianBlur(gray_horizontal, (3, 3), 0)
    _, mask_hz = cv2.threshold(blur_hz, 65, 255, cv2.THRESH_BINARY_INV)
    linha_preta_horizontal_detectada = False
    contornos_hz, _ = cv2.findContours(mask_hz, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    for p_contorno in contornos_hz:
        if cv2.contourArea(p_contorno) > 8:
            _, _, larg_hz, _ = cv2.boundingRect(p_contorno)
            if larg_hz > int(w * 0.30):
                linha_preta_horizontal_detectada = True
                break

    zona_rosa = frame[altura_linha_guia:altura_linha_guia + 2, x_inicio_guia:x_fim_guia]
    gray_rosa = cv2.cvtColor(zona_rosa, cv2.COLOR_BGR2GRAY)
    _, mask_rosa = cv2.threshold(gray_rosa, 65, 255, cv2.THRESH_BINARY_INV)
    linha_guia_confirmada = False
    contornos_rosa, _ = cv2.findContours(mask_rosa, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    for pr in contornos_rosa:
        _, _, larg_pr, _ = cv2.boundingRect(pr)
        if larg_pr >= int(w * 0.03):
            linha_guia_confirmada = True
            break

    zona_verde = frame[roi_verde_y1:roi_verde_y2, :]
    hsv_verde = cv2.cvtColor(zona_verde, cv2.COLOR_BGR2HSV)
    mask_verde = cv2.inRange(hsv_verde, LOWER_GREEN, UPPER_GREEN)
    kernel = np.ones((5, 5), np.uint8)
    mask_verde = cv2.morphologyEx(mask_verde, cv2.MORPH_OPEN, kernel)
    mask_verde = cv2.morphologyEx(mask_verde, cv2.MORPH_CLOSE, kernel)
    verdes_validos = []
    if not acao_imediata:
        contornos_verde, _ = cv2.findContours(mask_verde, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        for contorno_verde in contornos_verde:
            if cv2.contourArea(contorno_verde) > AREA_MINIMA_VERDE:
                x, y, larg, alt = cv2.boundingRect(contorno_verde)
                proporcao = larg / float(alt)
                if 0.4 < proporcao < 2.5:
                    Mv = cv2.moments(contorno_verde)
                    if Mv["m00"] != 0:
                        vx = int(Mv["m10"] / Mv["m00"])
                        verdes_validos.append(vx)

    if not acao_imediata:
        if frames_cinza >= FRAMES_NECESSARIOS:
            status = "ENTRADA RESGATE (CINZA)"
            executar_resgate = True
        elif linha_preta_horizontal_detectada and linha_guia_confirmada:
            frames_confirmacao_falsa += 1
        else:
            frames_confirmacao_falsa = max(0, frames_confirmacao_falsa - 1)

        if len(verdes_validos) >= 2 and not executar_resgate:
            frames_beco += 1
            frames_verde_esq = max(0, frames_verde_esq - 1)
            frames_verde_dir = max(0, frames_verde_dir - 1)
        elif len(verdes_validos) == 1 and not executar_resgate:
            frames_beco = max(0, frames_beco - 1)
            cx_verde = verdes_validos[0]
            if cx_verde < (cx_suave - 20):
                frames_verde_esq += 1
                frames_verde_dir = max(0, frames_verde_dir - 1)
            else:
                frames_verde_dir += 1
                frames_verde_esq = max(0, frames_verde_esq - 1)
        else:
            frames_beco = max(0, frames_beco - 1)
            frames_verde_esq = max(0, frames_verde_esq - 1)
            frames_verde_dir = max(0, frames_verde_dir - 1)

        if executar_resgate:
            pass 
        elif frames_confirmacao_falsa >= FRAMES_NECESSARIOS:
            status = "INTERS. FALSA - SIGA DIRETO"
            frames_confirmacao_falsa = FRAMES_NECESSARIOS
            vel_esq_final = VEL_BASE
            vel_dir_final = VEL_BASE
        elif frames_beco >= FRAMES_NECESSARIOS:
            status = "RETORNAR - BECO"
            executar_retorno_beco = True
        elif frames_verde_esq >= FRAMES_NECESSARIOS:
            status = "CURVA VERDE ESQUERDA"
            direcao_manobra = "ESQUERDA"
            executar_manobra_90 = True
        elif frames_verde_dir >= FRAMES_NECESSARIOS:
            status = "CURVA VERDE DIREITA"
            direcao_manobra = "DIREITA"
            executar_manobra_90 = True
        elif linha_detectada:
            erro_pixel = (w // 2) - cx_suave
            if abs(erro_pixel) <= MARGEM_TOLERANCIA:
                erro_pixel = 0
                kp_atual = KP_BASE
                status = "LINHA CENTRALIZADA"
            else:
                kp_atual = KP_BASE + (K_AGRESSIVO * abs(erro_pixel))
                status = f"KP:{kp_atual:.4f} ERRO:{erro_pixel}"
            acao_proporcional = kp_atual * erro_pixel
            vel_esq_final = VEL_BASE - acao_proporcional
            vel_dir_final = VEL_BASE + acao_proporcional
        else:
            status = "PROCURANDO LINHA - GAP"
            vel_esq_final = VEL_BASE * 0.7
            vel_dir_final = VEL_BASE * 0.7

    if executar_resgate:
        print(f"-> Status: ENTRADA RESGATE")
        executar_entrada_resgate()
        frames_cinza = 0
        memoria_centro_cx.clear()
        return

    if executar_retorno_beco:
        print(f"-> Status: EXECUTANDO BECO 180")
        manobra_beco()
        frames_beco = 0
        memoria_centro_cx.clear()
        return

    if executar_manobra_90:
        print(f"-> Status: EXECUTANDO 90 {direcao_manobra}")
        manobra_90(direcao_manobra)
        frames_verde_esq = 0
        frames_verde_dir = 0
        memoria_centro_cx.clear()
        return

    enviar_comando(vel_esq_final, vel_dir_final)

# >>> 5. LOOP PRINCIPAL AUTÔNOMO
def rodar_navegacao():
    print("-> Robô iniciado em modo autônomo (raspzits.py - PiCamera)!")
    while True:
        frame = camera.capture_array()  # Captura do array de imagem via Picamera2
        processar_frame(frame)

if __name__ == "__main__":
    try:
        rodar_navegacao()
    except KeyboardInterrupt:
        print("-> Navegação interrompida manualmente.")
    finally:
        enviar_comando(0.0, 0.0)
        camera.stop()
