#include <Servo.h>

// ============================================================================
// WAKANDA TECH - OBR 2026
// ARDUINO UNO R4 WIFI - CONTROLE DE 4 MOTORES / 2 DRIVERS
// Protocolo Serial: "vel_esq,vel_dir" em -1.00..1.00
// Comandos extras: STOP, LED_ON, LED_OFF, GARRA_DESCER, GARRA_SUBIR,
//                 GARRA_FECHAR, GARRA_ABRIR, PING
// ============================================================================

// --------------------------- CONFIGURAÇÃO GERAL -----------------------------
const unsigned long BAUDRATE = 115200;
const unsigned long TIMEOUT_SEGURANCA_MS = 1000;

// Relé / LED
const int PIN_RELE = 4;
const bool RELE_ATIVO_EM_LOW = true;
const bool LIGAR_LED_AO_INICIAR = true;

// Servos ainda não instalados: deixe false até a mecânica confirmar.
const bool USAR_SERVOS = false;
const int PIN_SERVO_BRACO = 10;
const int PIN_SERVO_PINCA = A3;

const int ANGULO_BRACO_ALTO = 160;
const int ANGULO_BRACO_BAIXO = 30;
const int ANGULO_PINCA_ABERTA = 40;
const int ANGULO_PINCA_FECHADA = 120;

// ------------------------------- DRIVER 1 -----------------------------------
// OUT1/OUT2 -> TRASEIRO ESQUERDO
const int D1_ENA = 3;
const int D1_IN1 = 2;
const int D1_IN2 = 6;

// OUT3/OUT4 -> TRASEIRO DIREITO
const int D1_IN3 = 7;
const int D1_IN4 = 8;
const int D1_ENB = 5;

// ------------------------------- DRIVER 2 -----------------------------------
// OUT1/OUT2 -> FRENTE DIREITA
const int D2_ENA = 9;
const int D2_IN1 = 12;
const int D2_IN2 = A2;

// OUT3/OUT4 -> FRENTE ESQUERDA
const int D2_IN3 = A0;
const int D2_IN4 = A1;
const int D2_ENB = 11;

// Se UM motor girar ao contrário durante o teste, altere apenas o respectivo
// false para true. Não troque a lógica do Python por causa de polaridade física.
const bool INVERTER_FRENTE_ESQ = false;
const bool INVERTER_TRAS_ESQ   = false;
const bool INVERTER_FRENTE_DIR = false;
const bool INVERTER_TRAS_DIR   = false;

// Limita a potência máxima enviada aos drivers (255 = 100%).
// Pode ser reduzido durante calibração, sem alterar o Python.
const int PWM_MAXIMO = 255;

// ----------------------------------------------------------------------------
unsigned long ultimaComunicacao = 0;
bool watchdogJaParou = false;

Servo servoBraco;
Servo servoPinca;

// ============================================================================
// FUNÇÕES AUXILIARES
// ============================================================================

void escreverRele(bool ligado) {
  bool nivelAtivo = RELE_ATIVO_EM_LOW ? LOW : HIGH;
  bool nivelInativo = RELE_ATIVO_EM_LOW ? HIGH : LOW;
  digitalWrite(PIN_RELE, ligado ? nivelAtivo : nivelInativo);
}

void configurarPinoMotor(int ena, int in1, int in2) {
  pinMode(ena, OUTPUT);
  pinMode(in1, OUTPUT);
  pinMode(in2, OUTPUT);
  analogWrite(ena, 0);
  digitalWrite(in1, LOW);
  digitalWrite(in2, LOW);
}

void acionarMotor(int ena, int in1, int in2, float velocidade, bool inverter) {
  if (inverter) velocidade = -velocidade;

  velocidade = constrain(velocidade, -1.0f, 1.0f);
  int pwm = (int)(fabs(velocidade) * PWM_MAXIMO);
  pwm = constrain(pwm, 0, PWM_MAXIMO);

  if (velocidade > 0.001f) {
    digitalWrite(in1, HIGH);
    digitalWrite(in2, LOW);
    analogWrite(ena, pwm);
  } else if (velocidade < -0.001f) {
    digitalWrite(in1, LOW);
    digitalWrite(in2, HIGH);
    analogWrite(ena, pwm);
  } else {
    // Coast/parada: PWM zerado e ambos sinais baixos.
    analogWrite(ena, 0);
    digitalWrite(in1, LOW);
    digitalWrite(in2, LOW);
  }
}

void controlarMotores(float velEsq, float velDir) {
  velEsq = constrain(velEsq, -1.0f, 1.0f);
  velDir = constrain(velDir, -1.0f, 1.0f);

  // LADO ESQUERDO
  acionarMotor(D2_ENB, D2_IN3, D2_IN4, velEsq, INVERTER_FRENTE_ESQ);
  acionarMotor(D1_ENA, D1_IN1, D1_IN2, velEsq, INVERTER_TRAS_ESQ);

  // LADO DIREITO
  acionarMotor(D2_ENA, D2_IN1, D2_IN2, velDir, INVERTER_FRENTE_DIR);
  acionarMotor(D1_ENB, D1_IN3, D1_IN4, velDir, INVERTER_TRAS_DIR);
}

void pararMotores() {
  controlarMotores(0.0f, 0.0f);
}

bool parsearVelocidades(const String &comando, float &velEsq, float &velDir) {
  int virgula = comando.indexOf(',');
  if (virgula <= 0 || virgula >= (int)comando.length() - 1) return false;

  String esquerda = comando.substring(0, virgula);
  String direita = comando.substring(virgula + 1);
  esquerda.trim();
  direita.trim();

  // toFloat() retorna 0 em strings inválidas. Para evitar aceitar lixo como 0,0,
  // exigimos ao menos algum caractere típico de número em cada campo.
  if (esquerda.length() == 0 || direita.length() == 0) return false;
  bool esqPareceNumero = esquerda.indexOf('.') >= 0 || esquerda.indexOf('-') >= 0 || isDigit(esquerda[0]);
  bool dirPareceNumero = direita.indexOf('.') >= 0 || direita.indexOf('-') >= 0 || isDigit(direita[0]);
  if (!esqPareceNumero || !dirPareceNumero) return false;

  velEsq = constrain(esquerda.toFloat(), -1.0f, 1.0f);
  velDir = constrain(direita.toFloat(), -1.0f, 1.0f);
  return true;
}

void processarComando(String comando) {
  comando.trim();
  if (comando.length() == 0) return;

  // Qualquer comando válido recebido do Raspberry mantém o watchdog vivo.
  ultimaComunicacao = millis();
  watchdogJaParou = false;

  if (comando == "STOP") {
    pararMotores();
    return;
  }

  if (comando == "PING") {
    Serial.println("PONG");
    return;
  }

  if (comando == "LED_ON") {
    escreverRele(true);
    return;
  }

  if (comando == "LED_OFF") {
    escreverRele(false);
    return;
  }

  if (comando == "GARRA_DESCER") {
    if (USAR_SERVOS) servoBraco.write(ANGULO_BRACO_BAIXO);
    return;
  }

  if (comando == "GARRA_SUBIR") {
    if (USAR_SERVOS) servoBraco.write(ANGULO_BRACO_ALTO);
    return;
  }

  if (comando == "GARRA_FECHAR") {
    if (USAR_SERVOS) servoPinca.write(ANGULO_PINCA_FECHADA);
    return;
  }

  if (comando == "GARRA_ABRIR") {
    if (USAR_SERVOS) servoPinca.write(ANGULO_PINCA_ABERTA);
    return;
  }

  float velEsq = 0.0f;
  float velDir = 0.0f;
  if (parsearVelocidades(comando, velEsq, velDir)) {
    controlarMotores(velEsq, velDir);
  }
}

// ============================================================================
// SETUP / LOOP
// ============================================================================

void setup() {
  // Segurança: configure e pare todos os motores antes de qualquer outra coisa.
  configurarPinoMotor(D1_ENA, D1_IN1, D1_IN2);
  configurarPinoMotor(D1_ENB, D1_IN3, D1_IN4);
  configurarPinoMotor(D2_ENA, D2_IN1, D2_IN2);
  configurarPinoMotor(D2_ENB, D2_IN3, D2_IN4);
  pararMotores();

  pinMode(PIN_RELE, OUTPUT);
  escreverRele(LIGAR_LED_AO_INICIAR);

  if (USAR_SERVOS) {
    servoBraco.attach(PIN_SERVO_BRACO);
    servoPinca.attach(PIN_SERVO_PINCA);
    servoBraco.write(ANGULO_BRACO_ALTO);
    servoPinca.write(ANGULO_PINCA_ABERTA);
  }

  Serial.begin(BAUDRATE);
  Serial.setTimeout(25);

  // Não usamos while(!Serial): o Arduino precisa inicializar sozinho no robô,
  // mesmo que o Raspberry ainda esteja terminando o boot.
  ultimaComunicacao = millis();
}

void loop() {
  if (Serial.available() > 0) {
    String comando = Serial.readStringUntil('\n');
    processarComando(comando);
  }

  // Se o Raspberry travar, fechar o processo ou o cabo USB cair, os quatro
  // motores são parados automaticamente.
  if (millis() - ultimaComunicacao > TIMEOUT_SEGURANCA_MS) {
    if (!watchdogJaParou) {
      pararMotores();
      watchdogJaParou = true;
    }
  }
}
